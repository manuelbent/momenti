{
  "name": "momenti-server",
  "version": "0.0.0-alpha",
  "description": "momenti API – bridge between the Svelte frontend and OpenAI",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate:up": "sequelize-cli db:migrate  --config ../database/config.cjs --migrations-path ../database/migrations",
    "migrate:down": "sequelize-cli db:migrate:undo  --config ../database/config.cjs --migrations-path ../database/migrations",
    "seed:all": "sequelize-cli db:seed:all --config ../database/config.cjs --seeders-path ../database/seeders"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "openai": "^6.35.0",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
