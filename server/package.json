{
  "name": "momenti-server",
  "version": "0.3.1-alpha",
  "description": "API layer for momenti.",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch src/server.ts",
    "build": "tsc && cp -r src/services/prompts dist/services/prompts",
    "start": "node dist/server.js",
    "migrate:up": "sequelize-cli db:migrate  --config ../database/config.cjs --migrations-path ../database/migrations",
    "migrate:down": "sequelize-cli db:migrate:undo  --config ../database/config.cjs --migrations-path ../database/migrations",
    "seed:all": "sequelize-cli db:seed:all --config ../database/config.cjs --seeders-path ../database/seeders"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@types/multer": "^2.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.10.1",
    "multer": "^2.1.1",
    "openai": "^6.35.0",
    "pino": "^10.3.1",
    "rate-limiter-flexible": "^11.1.0",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "ioredis-mock": "^8.13.1",
    "pino-pretty": "^13.1.3",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
