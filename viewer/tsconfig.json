{
  "compilerOptions": {
    "types": [
      "vite/client"
    ],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "$lib/*": ["src/lib/*"],
      "$shared/*": ["../shared/*"]
    }
  },
  "include": ["src", "../shared", "vite.config.ts"]
}
